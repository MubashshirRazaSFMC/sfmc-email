<body style="margin: 0; padding: 0; background-color: #f4f7f9;">

  <!-- Main Wrapper -->
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f4f7f9; padding: 40px 15px;">
    <tr>
      <td align="center">
        
        <!-- Email Container -->
        <table class="email-container" border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
          
          <!-- Header Banner -->
          <tr>
            <td align="center" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); padding: 35px 20px;">
              <h1 style="color: #ffffff; margin: 0; font-size: 26px; font-weight: 600; letter-spacing: 0.5px;">Welcome Aboard! 🎉</h1>
            </td>
          </tr>

          <!-- Main Body -->
          <tr>
            <td class="content-padding" style="padding: 40px 40px 30px 40px;">
              <p style="margin: 0 0 15px 0; font-size: 18px; color: #1e293b; font-weight: 600;">
                %%=v(@greeting)=%%
              </p>
              <p style="margin: 0 0 25px 0; font-size: 15px; line-height: 1.6; color: #475569;">
                Thank you for registering with us! We are thrilled to have you on board. Here is a summary of the details we currently have on file for your profile:
              </p>

              <!-- Details Card -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 20px; margin-bottom: 30px;">
                
                <!-- 1. Full Name Row -->
                %%[ IF NOT EMPTY(@finalFullName) THEN ]%%
                <tr>
                  <td class="detail-label" width="35%" style="padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;">Full Name</td>
                  <td class="detail-value" width="65%" style="padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;">%%=v(@finalFullName)=%%</td>
                </tr>
                %%[ ENDIF ]%%

                <!-- 2. Email Address Row -->
                %%[ IF NOT EMPTY(@emailLower) THEN ]%%
                <tr>
                  <td class="detail-label" style="padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;">Email Address</td>
                  <td class="detail-value" style="padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;">%%=v(@emailLower)=%%</td>
                </tr>
                %%[ ENDIF ]%%

                <!-- 3. Phone Number Row -->
                %%[ IF NOT EMPTY(@phone) THEN ]%%
                <tr>
                  <td class="detail-label" style="padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;">Phone Number</td>
                  <td class="detail-value" style="padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;">%%=v(@phone)=%%</td>
                </tr>
                %%[ ENDIF ]%%

                <!-- 4. Date of Birth Row -->
                %%[ IF NOT EMPTY(@dob) THEN ]%%
                <tr>
                  <td class="detail-label" style="padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;">Date of Birth</td>
                  <td class="detail-value" style="padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;">%%=v(@dob)=%%</td>
                </tr>
                %%[ ENDIF ]%%

                <!-- 5. Preferences Row -->
                %%[ IF NOT EMPTY(@pref) THEN ]%%
                <tr>
                  <td class="detail-label" style="padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;">Preferences</td>
                  <td class="detail-value" style="padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;">%%=v(@pref)=%%</td>
                </tr>
                %%[ ENDIF ]%%

                <!-- 6. Address Row -->
                %%[ IF NOT EMPTY(@fullAddress) THEN ]%%
                <tr>
                  <td class="detail-label" style="padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600;">Address</td>
                  <td class="detail-value" style="padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500;">%%=v(@fullAddress)=%%</td>
                </tr>
                %%[ ENDIF ]%%

              </table>

              <!-- Call to Action (Update Info) -->
              <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.5; color: #475569; text-align: center;">
                Notice a typo or need to make a change? You can easily update your profile anytime.
              </p>

              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding-bottom: 25px;">
                    <a href="https://yourwebsite.com/update-profile" class="btn" style="background-color: #2563eb; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 6px; font-weight: 600; font-size: 15px; display: inline-block;">
                      Update Your Information
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Sign-off -->
              <p style="margin: 15px 0 0 0; font-size: 15px; line-height: 1.6; color: #475569; border-top: 1px solid #e2e8f0; padding-top: 20px;">
                Best regards,<br>
                <strong style="color: #1e293b;">The Team</strong>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color: #f1f5f9; padding: 20px 40px; font-size: 12px; color: #94a3b8; line-height: 1.5;">
              <p style="margin: 0;">&copy; 2026 Your Company Name. All rights reserved.</p>
              <p style="margin: 5px 0 0 0;">
                If you didn't create an account with us, please ignore this email or <a href="mailto:support@yourwebsite.com" style="color: #2563eb; text-decoration: underline;">contact support</a>.
              </p>
            </td>
          </tr>

        </table>
        <!-- End Email Container -->

      </td>
    </tr>
  </table>

</body>
