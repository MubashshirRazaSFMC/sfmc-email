%%[
/* 1. Declare all variables */
VAR @firstName, @lastName, @pref, @phone, @streetAddress, @postcode, @state, @country, @email, @dob
VAR @finalFirstName, @finalLastName, @finalFullName, @emailLower, @fullAddress

/* 2. Retrieve all required fields safely using AttributeValue */
SET @firstName     = [First Name]
SET @lastName      = [Last Name]
SET @pref          = [Preferences]
SET @phone         = [Phone Number]
SET @streetAddress = [Street Address]
SET @postcode      = [Postcode]
SET @state         = [State]
SET @country       = [Country]
SET @email         = [Email]
SET @dob           = [Date of Birth]

/* 3. Logic for name cleaning (Nested Trim + ProperCase) */
SET @finalFirstName = ProperCase(Trim(@firstName))
SET @finalLastName  = ProperCase(Trim(@lastName))
SET @finalFullName  = Concat(@finalFirstName, " ", @finalLastName)

/* 4. Logic for email formatting */
SET @emailLower = Lowercase(Trim(@email))

/* 5. Logic for Full Address (Using your exact variable names) */
IF NOT EMPTY(@streetAddress) AND NOT EMPTY(@state) AND NOT EMPTY(@postcode) AND NOT EMPTY(@country) THEN
    SET @fullAddress = Concat(@streetAddress, ", ", @state, " ", @postcode, ", ", @country)
ELSE
    /* If any of the 4 fields are missing, keep fullAddress empty */
    SET @fullAddress = ""
ENDIF
]%%
